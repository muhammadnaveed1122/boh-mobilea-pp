@@ -935,10 +935,16 @@ - (void)configureAudioSession
 
     [audioSession setMode:mode error:nil];
 
-    double sampleRate = 44100.0;
+    // PATCHED (boh-mobile): 44100 → 48000. react-native-webrtc's voice engine
+    // runs at 48 kHz; a 44.1 kHz preferred rate on the CallKit-configured
+    // session distorts playback on the device (uplink unaffected).
+    double sampleRate = 48000.0;
     [audioSession setPreferredSampleRate:sampleRate error:nil];
 
-    NSTimeInterval bufferDuration = .005;
+    // PATCHED (boh-mobile): .005 → .02. A 5 ms IO buffer makes the VPIO audio
+    // unit miss render deadlines (playback underruns → "cutting" audio) while
+    // capture stays clean. 20 ms matches WebRTC's frame cadence.
+    NSTimeInterval bufferDuration = .02;
     [audioSession setPreferredIOBufferDuration:bufferDuration error:nil];
     [audioSession setActive:TRUE error:nil];
 }
