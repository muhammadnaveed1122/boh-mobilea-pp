diff --git a/ios/RNCallKeep/RNCallKeep.m b/ios/RNCallKeep/RNCallKeep.m
index 786045fea8f667bd112f90050c8018c96cde6a3b..0883cea3ff3c5740745b72616ad455649c03b341 100644
