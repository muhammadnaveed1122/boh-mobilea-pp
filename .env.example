# Backend API host. Do NOT include /api/v1 — versioning lives in service paths.
# Local dev (iOS simulator / web):
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# Local dev (Android emulator):
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
# Physical device on LAN: use your machine's LAN IP, e.g.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3000

# Socket.IO server origin for realtime notifications.
# Local dev: backend serves Socket.IO on a SEPARATE port (SOCKET_PORT, default 3002):
EXPO_PUBLIC_SOCKET_URL=http://localhost:3002
# Physical device on LAN: # EXPO_PUBLIC_SOCKET_URL=http://192.168.1.10:3002
# QA/prod (reverse-proxied on the API origin, path /socket.io):
# EXPO_PUBLIC_SOCKET_URL=https://api-qa.rhkproperties.com

# Public website origin for shareable web links (project/listing detail share buttons).
# Optional: when unset, src/lib/config.ts derives it from EXPO_PUBLIC_API_BASE_URL
# by dropping the `api-`/`api.` host prefix (falls back to QA for local/dev hosts).
# Set explicitly to override the derivation.
# Prod: EXPO_PUBLIC_WEB_BASE_URL=https://rhkproperties.com
# QA:   EXPO_PUBLIC_WEB_BASE_URL=https://qa.rhkproperties.com

# Google Maps API key (Android). iOS uses Apple Maps by default; set for Google provider.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Sign-In (mobile)
# webClientId MUST match backend GOOGLE_CLIENT_ID — the Web-type OAuth client.
# Required on Android to get a server-auth ID token; included in `aud` claim.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS-type OAuth client ID from Google Cloud Console. Bundle id: com.anonymous.boh-mobile.
# Reversed form goes into app.json plugin `iosUrlScheme`.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=


# Decryption key for leads contact details for admin view only
EXPO_PUBLIC_LEAD_CONTACT_ENCRYPTION_KEY=

 